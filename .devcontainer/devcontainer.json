{
  "name": "Wunschzettu",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/wunschzettu",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4200, 5299, "mailpit:8025"],
  "portsAttributes": {
    "4200": { "label": "Web (Angular)", "onAutoForward": "openBrowserOnce" },
    "5299": { "label": "API", "onAutoForward": "silent" },
    "mailpit:8025": { "label": "Mailpit" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "angular.ng-template", "esbenp.prettier-vscode"]
    }
  },
  "remoteUser": "vscode"
}
