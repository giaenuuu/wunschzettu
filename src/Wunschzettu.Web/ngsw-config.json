{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/pwa/**", "/i18n/**", "/media/**", "/*.woff2"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "images",
      "urls": ["/img/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 300, "maxAge": "30d" }
    },
    {
      "name": "api-read",
      "urls": ["/api/wishlists", "/api/wishlists/*", "/api/shared/**", "/api/auth/me"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 100, "maxAge": "7d", "timeout": "4s" }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/img/**", "!/healthz"]
}
